{
  "name": "@local/dsh-memo",
  "version": "1.0.0",
  "private": true,
  "description": "Per-conversation floating memo list with an AI memo tool, draggable panel, custom labels, background, text size and language.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alone-Ray/dsh-plugins.git",
    "directory": "plugins/dsh-memo"
  },
  "homepage": "https://github.com/Alone-Ray/dsh-plugins/tree/main/plugins/dsh-memo",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memo",
    "requirements",
    "todo",
    "notes"
  ],
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
