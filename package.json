{
  "name": "@local/dsh-session-cost",
  "version": "0.1.0",
  "private": true,
  "description": "Estimated spend of the open session, shown as a live currency pill beside the token reading under the composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alone-Ray/dsh-session-cost.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-cost",
    "tokens"
  ],
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
